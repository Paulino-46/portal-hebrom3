generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String   @db.Text
  location    String   @db.VarChar(255)
  date        DateTime @db.DateTime(0)
  time        String   @db.VarChar(20)
  image       String   @db.VarChar(500)
  createdAt   DateTime @default(now()) @updatedAt @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("events")
}

model News {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(255)
  summary    String   @db.Text
  content    String   @db.LongText
  author     String   @db.VarChar(255)
  image      String   @db.VarChar(500)
  createdAt  DateTime @default(now()) @updatedAt @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("news")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  church    String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}

model Cronograma {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  day         String    @db.VarChar(50)
  time        String?   @db.VarChar(50)
  details     String?   @db.Text
  description String?   @db.Text
  speaker     String?   @db.VarChar(255)
  date        DateTime? @db.DateTime(0)
  type        String    @default("weekly") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("cronograma")
}

model Conversation {
  id        String    @id @default(cuid())
  title     String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@map("conversations")
}

model Message {
  id            String      @id @default(cuid())
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String     @map("conversation_id")
  role          String      @db.VarChar(20)
  content       String      @db.LongText
  sources       String?     @db.LongText
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("messages")
}